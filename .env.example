# Variáveis de ambiente — copie este arquivo como .env e preencha localmente
# Configure estas variáveis no painel Netlify:
# Site configuration → Environment variables

# Chave da API SendGrid (começa com SG.)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E-mail remetente verificado no SendGrid
FROM_EMAIL=noreply@goyatravel.com.br
